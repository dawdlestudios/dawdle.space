{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "assist": {
    "enabled": true,
    "actions": {
      "recommended": true,
      "source": { "recommended": true, "organizeImports": "off" }
    }
  },
  "formatter": {
    "lineWidth": 100,
    "indentStyle": "tab"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noArrayIndexKey": "off",
        "noDuplicateProperties": "off"
      },
      "complexity": {
        "noUselessFragments": "off",
        "noImportantStyles": "off"
      },
      "style": {
        "noDescendingSpecificity": "off"
      },
      "correctness": {
        "useUniqueElementIds": "off"
      }
    }
  },
  "files": {
    "includes": ["**", "!**/dist/*", "!**/spec.ts*", "!**/.astro/*"]
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}

---
import { Editor } from "./../../components/Editor";
import Layout from "./../../layouts/Layout.astro";

import "monaco-editor/min/vs/editor/editor.main.css";

// I can't figure out why this isn't included anymore after switching pages.
// It's no where to be found in the source of monaco or monaco react.
// but it gets included in the dom (but only on the first page load)
import "./../../components/Editor/fallback.css";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (() => {
	return [{ params: { path: "edit" } }];
}) satisfies GetStaticPaths;
---

<Layout title="dawdle.space - editor">
  <main>
    <Editor client:only="react" />
  </main>
</Layout>

<style>
  main {
    flex: 1;
    display: flex;
  }
</style>

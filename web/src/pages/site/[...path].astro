---
import type { GetStaticPaths } from "astro";
import "../../components/FileBrowser/styles.module.css";
import { UserSite } from "../../components/Site";
import SettingsLayout from "../../layouts/SettingsLayout.astro";

export const getStaticPaths = (() => {
	return [{ params: { path: "site" } }];
}) satisfies GetStaticPaths;

export const prerender = false;
---

<SettingsLayout title="dawdle.space">
  <section class="files">
    <UserSite transition:persist="filebrowser" client:only="react" />
  </section>
</SettingsLayout>

<style>
  .files {
    flex: 1;
    display: flex;

    h2 {
      padding: 1rem;
    }
  }
</style>

---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="join dawdle.space">
  <main>
    <!-- <h3>Already a member? <a href="/login">Login</a></h3> -->
    <h2>Thanks for your interest in joining dawdle.space!</h2>
    <p>
        To prevent spam, your submission will be reviewed by a human before you can start using the site.
        Please fill out the form below and we will get back to you as soon as possible.
        If you have any questions, feel free to reach out to us at <a href="mailto:hi@dawdle.space">hi@dawdle.space</a>
    </p>
    <form id="joinform">
      <label for="username">Username (required)</label>
      <input
        type="text"
        id="username"
        name="username"
        pattern="^[A-Za-z0-9]{1,20}$"
        required
        minlength="3"
        maxlength="20"
        placeholder="Your desired username"
      />
      <label for="email">Email (required)</label>
      <input
        type="email"
        autocomplete="email"
        id="email"
        name="email"
        required
        placeholder="Your email address"
      />

      <label for="about">About yourself (optional)</label>
      <textarea
        name="about"
        id="about"
        cols="30"
        rows="3"
        placeholder="Tell us a little about yourself, why you want to join, how you found out about us, etc."
      ></textarea>

      <div></div>
      <label for="terms">
        <input type="checkbox" id="terms" name="terms" required />
        I have read and agree to the <a target="_blank" href="/terms"
          >terms</a
        > and <a target="_blank" href="/terms"
        >privacy policy</a
      >
      </label>
      <input type="submit" value="Submit" />
    </form>
  </main>
</Layout>

<script>
  import { navigate } from "astro:transitions/client";
  import { api } from "../../api";

  const handleSubmit = async (e: Event) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const formData = new FormData(form);
    const [username, email, about] = [
      formData.get("username"),
      formData.get("email"),
      formData.get("about") || "no about provided",
    ];

    if (!username || !email || !about) {
      (
        form.querySelector("input[type=submit]") as HTMLInputElement
      )?.setCustomValidity("Something went wrong. Please try again later.");
      return;
    }

    api["/api/auth/apply"]
      .post({
        json: {
          username: username as string,
          email: email as string,
          about: about as string,
        },
      })
      .json()
      .then(() => {
        form.reset();
        navigate("/join/success", { history: "replace" });
      })
      .catch(() => {
        (
          form.querySelector("input[type=submit]") as HTMLInputElement
        )?.setCustomValidity("Something went wrong. Please try again later.");
      });
  };

  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("joinform");
    form?.addEventListener("submit", handleSubmit);
  });
</script>

<style>
  form {
    display: flex;
    flex-direction: column;
    margin-top: 1rem;

    label {
      margin-top: 1rem;
    }
  }

  h3 {
    margin-bottom: 3rem;
  }

  h2 {
    margin-bottom: 1rem;
  }

  main {
    padding: 1rem;
    padding-top: 3rem;
    height: fit-content;
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: center;
    margin: 0 auto;
    max-width: 45rem;
  }
</style>

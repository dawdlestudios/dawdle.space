---
import BG from "../components/BG.astro";
import { LoginLink } from "../components/auth";
import Base from "../layouts/Base.astro";
interface Props {
  title: string;
  background?: string;
}
const props = Astro.props;
const url = new URL(Astro.request.url);
---

<Base {...props}>
  <slot name="head" slot="head" />
  <BG />

  <header>
    <h1>dawdle.space</h1>
  </header>
  <ul class="tabs">
    <li data-active={url.pathname === "/"}>
      <a href="/">home</a>
    </li>
    <li data-active={url.pathname.startsWith("/sites")}>
      <a href="/sites">sites</a>
    </li>
    <!-- <li data-active={url.pathname.startsWith("/wiki")}>
      <a href="/wiki">wiki</a>
    </li> -->
    <!-- <li data-active={url.pathname.startsWith("/chat")}>
      <a href="/chat">chat</a>
    </li> -->
    <LoginLink client:only="react" transition:persist />
  </ul>
  <div class="page">
    <slot />
  </div>
  <div class="footer">
    <!-- <a href="https://henry.dawdle.space">made by ~henry</a> -->
    <a href="/imprint">imprint</a>
    <a href="/privacy">privacy</a>
    <a href="/terms">terms</a>
  </div>

  <style define:vars={{ overridebg: props.background }}>
    .footer {
      letter-spacing: -1px;
      margin-top: 0.8rem;

      a {
        color: var(--text-dark);
        margin-right: 0.5rem;
        font-size: 1.1rem;
      }
    }

    .tabs {
      background: var(--background);
      display: flex;
      list-style: none;
      overflow: hidden;
      padding: 0;
      margin: 0;
      border: var(--border);
      border-top-left-radius: var(--border-radius);
      border-top-right-radius: var(--border-radius);
      border-bottom: none;
      height: fit-content;

      :global(li a) {
        padding: 0 0.9rem;
        color: var(--text-dark);
        font-weight: 400;
        text-decoration: none;

        &:hover {
          color: #fff;
        }
      }

      :global(li) {
        &[data-active="true"] {
          /* background: var(--accent); */
          a {
            color: #fff;
            font-weight: 600;
          }
        }

        padding: 0.5rem 0;
        /* border-right: var(--border); */
      }

      :global(.login) {
        margin-left: auto;
        border-right: none;
      }

      @media (max-width: 600px) {
        justify-content: space-around;
        min-width: 100%;
        max-width: calc(100vw - 2rem);

        :global(li) {
          text-align: center;
          flex: 1;
          border-right: none;
          margin: 0;
          &:last-of-type {
            margin-left: 0;
          }

          a {
            padding: 0;
          }
        }
      }
    }

    html {
      background-size: 224px;
      padding: 2rem;
      justify-content: center;
      align-items: center;
      @media (max-width: 600px) {
        padding: 1rem 1rem;
      }
    }

    header {
      display: flex;
      padding-bottom: 0.5rem;
      align-items: baseline;
      gap: 0.5rem;

      @media (max-width: 600px) {
        padding-top: 0.5rem;
        padding-bottom: 1rem;
      }

      .x {
        width: 1rem;
        height: 1rem;
        font-size: 2.5rem;
        line-height: 1;
        color: #ececec;
      }

      .online {
        color: var(--text-dark);
      }

      h1 {
        font-size: 1.5rem;
        margin: 0;
        margin-right: auto;
        padding: 0;
        color: #d3eef1;
        line-height: 1;
      }
    }

    .page {
      flex-direction: column;
      background: var(--overridebg, var(--background));
      display: flex;
      border: var(--border);
      border-bottom-left-radius: var(--border-radius);
      border-bottom-right-radius: var(--border-radius);
      flex: 1;
      color: var(--text);
      overflow: auto;

      :global(h1, h2, h3) {
        color: var(--heading);
      }
    }

    body {
      max-width: var(--max-width, 800px);
      flex: 1;
      display: flex;
      margin: 0;
      padding: 0;
      font-size: 1.3rem;
      line-height: 1.3;
      flex-direction: column;
      min-height: 50rem;
      height: calc(100vh - 15rem);
    }

    header h1 {
      animation: headerBreathe 4s infinite alternate;
    }

    @keyframes headerBreathe {
      from {
        filter: drop-shadow(0 0 3px #04ffff00);
      }
      to {
        filter: drop-shadow(0 0 3px #5412e4b6);
      }
    }
  </style>
</Base>

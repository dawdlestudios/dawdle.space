---
import { SettingsHeader } from "../components/Settings";
import Layout from "./Layout.astro";

interface Props {
	title: string;
}
const { title } = Astro.props;
const url = new URL(Astro.request.url);
---

<Layout title={title}>
  <!-- <SettingsHeader  client:load /> -->
  <ul>
    <li data-active={!url.pathname.startsWith("/me/settings")}>
      <a href="/me">Your Sites</a>
    </li>
    <li data-active={url.pathname.startsWith("/me/settings")}>
      <a href="/me/settings">User Settings</a>
    </li>
    <li class="signout">
      <a href="/me/logout">Sign Out</a>
    </li>
  </ul>
  <slot />
</Layout>

<script>
  import { getUser } from "../utils/auth";
  const username = getUser();

  const setUsername = () => {
    if (!username) {
      location.href = "/login";
      return;
    }

    document
      .querySelectorAll("#settings [data-username]")
      .forEach((el) => (el.textContent = username));

    (
      document.querySelectorAll(
        "#settings [data-user-page]"
      ) as NodeListOf<HTMLAnchorElement>
    ).forEach((el) => (el.href = `https://${username}.dawdle.space`));
  };

  document.addEventListener("astro:after-swap", () => setUsername());
  setUsername();
</script>

<style>
  

  ul {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    border-bottom: var(--border);

    li[data-active="true"] {
      background: var(--border-color);
      a {
        color: #141f28;
        font-weight: 800;
      }
    }

    li {
      border-right: var(--border);
      font-size: 0.8rem;
      display: flex;
      align-items: center;

      a {
        color: var(--text-dark);
        text-decoration: none;
        padding: 0.5rem 1.2rem;
      }
    }

    li.signout {
      margin-left: auto;
      border: none;
      a {
        padding: 0 0.7rem;
      }
    }
  }
</style>
